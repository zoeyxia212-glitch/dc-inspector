[Unit]
Description=DC Inspector central web/API
After=network-online.target
Wants=network-online.target

[Service]
User=inspector
Group=inspector
WorkingDirectory=/opt/dc-inspector
EnvironmentFile=/etc/dc-inspector/central.env
ExecStart=/opt/dc-inspector/venv/bin/gunicorn -w 4 -b 127.0.0.1:8000 --access-logfile - "inspector.app:create_app()"
Restart=always
RestartSec=5
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/dc-inspector

[Install]
WantedBy=multi-user.target
