# Copy to .env and change every value. docker compose reads .env automatically.
INSPECTOR_ADMIN_PASSWORD=change-me-please-123
INSPECTOR_SECRET_KEY=replace-with-output-of-python-c-import-secrets-print-secrets-token-hex-32
# Collector API tokens. Must be generated (made-up values are rejected): python -m inspector.main gen-token
TOKEN_SH_NORTH=replace-with-output-of-gen-token
TOKEN_SH_SOUTH=replace-with-output-of-gen-token
# Optional notification channels (leave empty to disable delivery; alerts still show in the UI)
WECOM_WEBHOOK_URL=
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=
SLACK_WEBHOOK_URL=
SMTP_PASSWORD=
# Optional: bearer token for Prometheus to scrape /metrics (otherwise a logged-in session is required)
INSPECTOR_METRICS_TOKEN=
