# Copy to .env and change every value. docker compose reads .env automatically.
INSPECTOR_ADMIN_PASSWORD=change-me-please-123
INSPECTOR_SECRET_KEY=replace-with-output-of-python-c-import-secrets-print-secrets-token-hex-32
# Collector API tokens (>= 24 chars). Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
TOKEN_SH_NORTH=replace-with-a-long-random-token-north
TOKEN_SH_SOUTH=replace-with-a-long-random-token-south
# Optional notification channels (leave empty to disable delivery; alerts still show in the UI)
WECOM_WEBHOOK_URL=
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=
SLACK_WEBHOOK_URL=
SMTP_PASSWORD=
